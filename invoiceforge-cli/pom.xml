<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.invoiceforge</groupId>
        <artifactId>invoiceforge</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>invoiceforge-cli</artifactId>

    <dependencies>
        <dependency>
            <groupId>ch.invoiceforge</groupId>
            <artifactId>invoiceforge-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.invoiceforge</groupId>
            <artifactId>invoiceforge-pdf</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.invoiceforge</groupId>
            <artifactId>invoiceforge-export</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>ch.invoiceforge.cli.InvoiceForgeCli</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
